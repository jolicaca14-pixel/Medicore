{
    "name": "medicore-backend",
    "version": "1.0.0",
    "description": "Backend modular para sistema de gestión clínica HealthTech PWA",
    "main": "dist/server.js",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "migrate": "node dist/database/migrate.js"
    },
    "keywords": [
        "healthtech",
        "pwa",
        "backend",
        "pern"
    ],
    "author": "MediCore Team",
    "license": "MIT",
    "dependencies": {
        "bcrypt": "^5.1.1",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "jsonwebtoken": "^9.0.2",
        "pg": "^8.11.3"
    },
    "devDependencies": {
        "@types/bcrypt": "^5.0.2",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.25",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^20.10.0",
        "@types/pg": "^8.20.0",
        "@types/uuid": "^10.0.0",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.3.3"
    }
}
